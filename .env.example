# Servico do bot
HOST=127.0.0.1
PORT=3100
BOT_DATA_DIR=./data
BOT_ADMIN_TOKEN=troque-por-um-segredo-longo
BOT_BRIDGE_TOKEN=troque-por-outro-segredo-longo

# Evolution API v2 (na VPS)
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_URL=http://bot:3100/webhooks/evolution

# Worker: desligado por padrao ate a homologacao
DISPATCH_ENABLED=false
WORKER_INTERVAL_MS=1000
HTTP_TIMEOUT_MS=15000

# Ponte local LexRadar -> VPS do bot
# Opcional: vazio usa o marcador oficial criado pelo LexRadar neste computador.
LEXRADAR_STATE_PATH=
BOT_REMOTE_URL=http://127.0.0.1:3100
BRIDGE_INTERVAL_MS=30000
BRIDGE_MAX_STATE_BYTES=52428800
BRIDGE_MAX_LEADS=10000
# Mantenha false ao usar o tunel SSH. true exige endpoint remoto HTTPS.
BRIDGE_ALLOW_REMOTE=false
