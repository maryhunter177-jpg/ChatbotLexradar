# Servico do bot
HOST=127.0.0.1
PORT=3100
BOT_DATA_DIR=./data
BOT_ADMIN_TOKEN=troque-por-um-segredo-longo
BOT_BRIDGE_TOKEN=troque-por-outro-segredo-longo

# Evolution API v2 (na VPS)
EVOLUTION_BASE_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
